# Server-only. Studio starts in manual mode without credentials.
FLUID_PROJECT_ROOT=
# Keep the real key only in the ignored root .env.local (permissions 0600).
OPENAI_API_KEY=
# Direct OpenAI via Vercel AI SDK is the default. Never use NEXT_PUBLIC_ for keys.
FLUID_AI_REVIEW_PROVIDER=openai
FLUID_AI_REVIEW_MODEL=gpt-6.1-terra
# Optional, explicitly selected Gateway configuration.
AI_GATEWAY_API_KEY=
FLUID_AI_MODEL=
FLUID_SESSION_BUDGET_USD=0.35
