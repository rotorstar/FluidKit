{
  "name": "fluidkit-pro",
  "version": "0.2.0-alpha.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @fluidkit/studio",
    "build": "npm run build:packages && npm run build -w @fluidkit/studio",
    "build:packages": "node scripts/build-packages.mjs",
    "start": "npm run start -w @fluidkit/studio",
    "type-check": "tsc --noEmit",
    "lint": "eslint packages apps scripts tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run type-check && npm run lint && npm test",
    "fluid": "node --import tsx packages/cli/src/index.ts",
    "check:plan": "node scripts/check-plan.mjs",
    "docs:update": "node --import tsx scripts/update-feature-docs.ts",
    "check:flows": "node scripts/check-mermaid.mjs",
    "build:gpu-kernels": "node scripts/build-gpu-kernels.mjs",
    "predev": "npm run build:gpu-kernels",
    "pretype-check": "npm run build:gpu-kernels && npm run check:design",
    "pretest": "npm run build:gpu-kernels",
    "check:design": "node --import tsx scripts/check-design.ts",
    "quality:gate": "npm run check && npm run check:acceptance && npm run check:plan && npm run check:flows && npm run knowledge:check && npm run build",
    "check:acceptance": "node --import tsx scripts/check-acceptance.ts",
    "docs:acceptance": "node --import tsx scripts/check-acceptance.ts --write",
    "build:font": "node scripts/bake-font.mjs",
    "check:font": "node scripts/bake-font.mjs --check",
    "check:release": "node --import tsx scripts/check-acceptance.ts --require-complete",
    "knowledge:sync": "node --import tsx scripts/knowledge/sync.ts",
    "knowledge:check": "node --import tsx scripts/knowledge/check.ts --write",
    "knowledge:build": "node --import tsx scripts/knowledge/build.ts",
    "knowledge:export": "node --import tsx scripts/knowledge/export.ts",
    "knowledge:serve": "node --import tsx scripts/knowledge/serve.ts"
  },
  "devDependencies": {
    "@enmera/ai-design-check": "0.9.0",
    "@fontsource/inter": "5.2.8",
    "@playwright/test": "1.64.1",
    "@types/markdown-it-footnote": "3.0.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0",
    "mermaid": "12.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "unplugin-typegpu": "0.12.7",
    "use-intl": "4.15.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
